          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Modify BPA for Workflow" enabled="true">
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def bpaJson = vars.get(&quot;bpaObject&quot;)
if (bpaJson != null &amp;&amp; !bpaJson.equals(&quot;{}&quot;)) {
    def bpa = new JsonSlurper().parseText(bpaJson)
    bpa.workflow = [action: &quot;FORWARD&quot;, comment: &quot;Performance test&quot;, assignee: null, assignes: null]
    bpa.action = &quot;FORWARD&quot;
    bpa.comment = &quot;&quot;
    vars.put(&quot;bpaObject&quot;, JsonOutput.toJson(bpa))
}
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
