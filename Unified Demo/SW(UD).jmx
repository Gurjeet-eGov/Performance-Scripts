vars.put(&quot;boundaryPincode&quot;, json.pincode ?: &quot;&quot;)
vars.put(&quot;boundaryCode&quot;, json.code ?: &quot;&quot;)
vars.put(&quot;boundaryName&quot;, json.name ?: &quot;&quot;)
</stringProp>
