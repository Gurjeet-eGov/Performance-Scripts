                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// 1. Read the saved JSON string from JMeter variable
def originalJson = vars.get(&quot;SewerageConnections&quot;)

// 2. Parse JSON into an object so we can work with it
def obj = new JsonSlurper().parseText(originalJson)

obj.connectionExecutionDate = 1762021799000
obj.processInstance.action = &quot;ACTIVATE_CONNECTION&quot;
obj.serviceType = &quot;SEWERAGE&quot;
obj.action = &quot;ACTIVATE_CONNECTION&quot;

// 4. Convert back into JSON string
def newJson = JsonOutput.toJson(obj)

// 5. Save into a new JMeter variable
vars.put(&quot;modifiedPropertyPayload&quot;, newJson)
</stringProp>
