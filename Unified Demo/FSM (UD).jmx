                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// 1. Read the saved JSON string from JMeter variable
def originalJson = vars.get(&quot;fsm&quot;)

// 2. Parse JSON into an object so we can work with it
def obj = new JsonSlurper().parseText(originalJson)

obj.applicationStatus = &quot;DSO_INPROGRESS&quot;
obj.completedOn = 1765238400000
obj.wasteCollected = 1000
obj.workers = [[
