                <stringProp name="Argument.value">${userType}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
                <boolProp name="HTTPArgument.use_equals">true</boolProp>
              </elementProp>
              <elementProp name="tenantId" elementType="HTTPArgument">
