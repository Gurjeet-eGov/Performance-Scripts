          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="/egov-survey-services/egov-ss/survey/_create">
            <stringProp name="HTTPSampler.domain">${URL}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/egov-survey-services/egov-ss/survey/_create?tenantId=${state_tenant}.${city_tenant}</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&#xd;
    &quot;SurveyEntity&quot;: {&#xd;
        &quot;tenantIds&quot;: [&#xd;
            &quot;${state_tenant}.${city_tenant}&quot;&#xd;
        ],&#xd;
        &quot;title&quot;: &quot;TESTNAME${randNum}&quot;,&#xd;
        &quot;description&quot;: &quot;TEST DESC (jMeter)&quot;,&#xd;
        &quot;startDate&quot;: ${startDate},&#xd;
    	   &quot;endDate&quot;: ${endDate},&#xd;
        &quot;questions&quot;: [&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;Short Quest&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: true,&#xd;
        &quot;type&quot;: &quot;SHORT_ANSWER_TYPE&quot;&#xd;
      },&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;MCQ&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: false,&#xd;
        &quot;type&quot;: &quot;MULTIPLE_ANSWER_TYPE&quot;,&#xd;
        &quot;options&quot;: [&#xd;
          &quot;Option 1&quot;,&#xd;
          &quot;Option 2&quot;&#xd;
        ]&#xd;
      },&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;CheckBox Ques&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: false,&#xd;
        &quot;type&quot;: &quot;CHECKBOX_ANSWER_TYPE&quot;,&#xd;
        &quot;options&quot;: [&#xd;
          &quot;Option 1&quot;,&#xd;
          &quot;Option 2&quot;&#xd;
        ]&#xd;
      },&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;Long Ans Ques&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: false,&#xd;
        &quot;type&quot;: &quot;LONG_ANSWER_TYPE&quot;&#xd;
      },&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;Date Ques&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: false,&#xd;
        &quot;type&quot;: &quot;DATE_ANSWER_TYPE&quot;&#xd;
      },&#xd;
      {&#xd;
        &quot;questionStatement&quot;: &quot;Time Ques&quot;,&#xd;
        &quot;uuid&quot;: null,&#xd;
        &quot;qorder&quot;: null,&#xd;
        &quot;status&quot;: &quot;ACTIVE&quot;,&#xd;
        &quot;required&quot;: false,&#xd;
        &quot;type&quot;: &quot;TIME_ANSWER_TYPE&quot;&#xd;
      }&#xd;
    ]&#xd;
    },&#xd;
    &quot;tenantId&quot;: &quot;${state_tenant}.${city_tenant}&quot;,&#xd;
    &quot;RequestInfo&quot;: {&#xd;
    &quot;apiId&quot;: &quot;Rainmaker&quot;,&#xd;
    &quot;authToken&quot;: &quot;${__P(e_authToken)}&quot;,&#xd;
