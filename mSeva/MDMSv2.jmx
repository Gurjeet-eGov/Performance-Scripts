            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// ------------------- CONFIGURE RANGE HERE (hard-coded) -------------------
int START = 1200    // inclusive start
int END   = 1400    // inclusive end
// ------------------------------------------------------------------------

// Key used to store the pool in JMeter properties (shared across threads)
String poolKey = &apos;UNIQUE_RANDOM_POOL_&apos; + START + &apos;_&apos; + END

// Initialize pool once (list of numbers shuffled) and store in props
synchronized(props) {
    if (!props.containsKey(poolKey)) {
        // create list of ints from START..END
        def numbers = (START..END).toList() as java.util.ArrayList
        java.util.Collections.shuffle(numbers)
        // store the list (props accepts objects)
        props.put(poolKey, numbers)
    }
}

// Retrieve the shuffled list (thread-safe removal using synchronized block)
Integer chosen = null
synchronized(props) {
    def numbers = props.get(poolKey) as java.util.ArrayList
    if (numbers == null) {
        throw new IllegalStateException(&quot;Unique random pool not initialized.&quot;)
    }
    if (numbers.isEmpty()) {
        // All numbers exhausted - choose behavior:
        // Option A: throw error (current behavior)
        throw new IllegalStateException(&quot;No more unique numbers available in range ${START}-${END}&quot;)
        // Option B (alternative): refill or reuse -- not implemented to guarantee uniqueness
    }
    // Remove and get the last element (fast)
    chosen = numbers.remove(numbers.size() - 1) as Integer
    // put the updated list back (props stores reference anyway, but safe)
    props.put(poolKey, numbers)
}

// Put into JMeter variable so sampler can use ${RAND_UNIQ}
vars.put(&apos;RAND_UNIQ&apos;, chosen.toString())

// (Optional) log for debugging - comment out in production
log.info(&quot;Assigned unique random number: ${chosen}&quot;)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
